<?xml version="1.0" encoding="utf-8" ?>
<widget
    id="scaletech.scaletechdropdown.ScaletechDropdown"
    pluginWidget="true"
    needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Scaletech Dropdown</name>
    <description>My widget description</description>
    <icon>
        
    </icon>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Data source">
                <property key="DataType" type="enumeration" defaultValue="Association">
                    <caption>Type</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="Association">Association</enumerationValue>
                        <enumerationValue key="Enumeration">Enumeration</enumerationValue>
                        <enumerationValue key="Boolean">Boolean</enumerationValue>
                    </enumerationValues>
                </property>
                <!-- Association property type -->
                <property
                    key="associationData"
                    type="association"
                    selectableObjects="objectsDatasources"
                    required="false"
                >
                    <caption>Entity</caption>
                    <description />
                    <associationTypes>
                        <associationType name="Reference" />
                        <associationType name="ReferenceSet" />
                    </associationTypes>
                </property>
                <property key="objectsDatasources" type="datasource" isList="true" required="true">
                    <caption>Selectable Objects</caption>
                    <description />
                </property>
                <property key="myOption" type="textTemplate" dataSource="objectsDatasources">
                    <caption>Caption</caption>
                    <description />
                    <translations>
                        <translation lang="en_US" />
                    </translations>
                </property>

                <!-- Enumeration property type -->
                <property key="EnumerationValue" type="attribute" required="true">
                    <caption>Attribute</caption>
                    <description />
                    <attributeTypes>
                        <attributeType name="Enum" />
                    </attributeTypes>
                </property>

                <!-- Boolean Property type -->
                <property key="BooleanValue" type="attribute" required="true">
                    <caption>Attribute</caption>
                    <description />
                    <attributeTypes>
                        <attributeType name="Boolean" />
                    </attributeTypes>
                </property>
            </propertyGroup>

            <propertyGroup caption="General">
                <property key="myPlaceholderText" type="textTemplate" required="false">
                    <caption>Placeholder Text</caption>
                    <description />
                    <translations>
                        <translation lang="en_US" />
                    </translations>
                </property>
            </propertyGroup>

            <propertyGroup caption="Multi Selection">
                <property key="SelectionMethod" type="enumeration" defaultValue="RowClick">
                    <caption>Selection Method</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="Checkbox">Checkbox</enumerationValue>
                        <enumerationValue key="RowClick">Row click</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="isSelect" type="boolean" defaultValue="true">
                    <caption>Show Select All</caption>
                    <description>add a button to select/deselect all option</description>
                </property>
                <property key="CaptionSelect" type="textTemplate">
                    <caption>Caption For Select All</caption>
                    <description />
                    <translations>
                        <translation lang="en_US">Select all</translation>
                    </translations>
                </property>
            </propertyGroup>

            <propertyGroup caption="Label">
                <systemProperty key="Label" />
            </propertyGroup>
            <propertyGroup caption="Conditional Visibility">
                <systemProperty key="Visibility" />
            </propertyGroup>
            <propertyGroup caption="Editability">
                <systemProperty key="Editability" />
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="OnChange" type="action" required="false">
                <caption>On change action</caption>
                <description>Action to be performed when button is clicked</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
